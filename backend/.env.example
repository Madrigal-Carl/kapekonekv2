# --- App ---
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
# MongoDB Atlas, with /kapekonek before the "?"
MONGO_URI=

# --- Auth: JWT secrets need 32+ characters, CRON_SECRET 16+. Generate each with:
#     node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRES=15m

# --- Email (MAIL_TRANSPORT=log writes emails to backend/storage/mail/) ---
MAIL_TRANSPORT=log
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=KapeKonek
KALUPPA_ORDERS_EMAIL=

# --- Valkey (Aiven: VALKEY_TLS=true; local Docker valkey: false) ---
VALKEY_HOST=
VALKEY_PORT=
VALKEY_USERNAME=default
VALKEY_PASSWORD=
VALKEY_TLS=true

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_ROOT_FOLDER=kapekonek

# --- Mapbox (server token: directions + geocoding; no URL restriction; never sent to the frontend) ---
MAPBOX_ACCESS_TOKEN=

# --- Orders, cron, seeding ---
ORDER_EXPIRY_DAYS=3
ORDER_EXPIRY_INTERVAL_MINUTES=5
CRON_SECRET=
# (CRON_SECRET: same generator; used as the x-cron-secret header for POST /api/cron/expire-orders)
SEED_DEFAULT_PASSWORD=KapeKonek@123
# (SEED_EMAIL_BASE: your own Gmail, e.g. you@gmail.com. Seed accounts become you+<handle>@gmail.com and their emails reach your inbox.
#  Leave it empty and seed accounts are kapekonek.<handle>@gmail.com; the mail worker never emails them, it writes to storage/mail/ instead.)
SEED_EMAIL_BASE=
